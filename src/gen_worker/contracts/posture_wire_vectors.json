  "identity_rules": [
    {
      "rule": "components are SORTED before digesting",
      "a": "clean_resident",
      "b": "clean_resident_components_reversed",
      "same_digest": true,
      "why": "A worker enumerating its pipeline in a different order is the same posture. If this goes red the identity forks on an implementation detail of the producer and every cell splits in two."
    },
    {
      "rule": "applied techniques are NOT sorted",
      "a": "reactive_descent",
      "b": "reactive_descent_levers_swapped",
      "same_digest": false,
      "why": "The order the worker reached for levers is a fact about the run. If this goes green the two descents aggregate into a cell whose mean describes neither."
    },
    {
      "rule": "shortfall magnitudes are EXCLUDED",
      "a": "reactive_descent",
      "b": "reactive_descent_bigger_shortfall",
      "same_digest": true,
      "why": "Two runs short by 6.1 and 6.3 GiB that reached for the same levers are one cell with two samples. Including the byte counts shatters every cell into singletons."
    },
    {
      "rule": "est_slowdown is EXCLUDED",
      "a": "reactive_descent",
      "b": "reactive_descent_reestimated",
      "same_digest": true,
      "why": "It is the worker's estimate OF the lever, not a property of the run. Two SDK versions estimating differently must not fork one posture."
    },
    {
      "rule": "wanted is an IDENTITY axis",
      "a": "isolated_wanted_flash",
      "b": "isolated_wanted_sdpa",
      "same_digest": false,
      "why": "Identical numbers, opposite meanings: one is a clean measurement of the sdpa lane, the other is evidence the pair is mis-ranked. Keyed on the ISOLATED pair — the realistic one below differs in `applied` too, so it stays green when `wanted` is severed and proves nothing."
    },
    {
      "rule": "wanted is an IDENTITY axis (the realistic pair)",
      "a": "ie707_silent_sdpa_fallback",
      "b": "deliberate_sdpa",
      "same_digest": false,
      "why": "The same rule as it appears in the field: the silent fallback also raises a lever, so this pair separates for two reasons. Kept because it is the shape a reader will actually meet, and NOT relied on as the red proof."
    },
    {
      "rule": "the APPLIED compile state is NOT an identity axis",
      "a": "honest_eager",
      "b": "honest_compiled",
      "same_digest": true,
      "why": "§1.30: compile is a cache question over (execution, GPU) — always preferred, never identity. Keying on it splits every cell in two on a fact that is not part of what it is."
    },
    {
      "rule": "a compile MISMATCH IS an identity axis",
      "a": "honest_compiled",
      "b": "h3_declared_compiled_ran_eager",
      "same_digest": false,
      "why": "Asked compiled, got eager is a degradation with an owner, not a cache state. Averaging it into the compiled number is how minimax-h3's eager hours vanished."
    },
    {
      "rule": "an unreported posture is not a clean one",
      "a": "unreported",
      "b": "clean_resident",
      "same_digest": false,
      "why": "Nobody looked and everything was fine must never share a key. This is the property that lets the typed posture arrive with no backfill and no dual-read."
    }
  ]
}
